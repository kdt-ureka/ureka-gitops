#!/bin/bash
# k3s 호스트 첫 부팅 설정 (이슈 #32). user data는 첫 부팅에 한 번만 실행된다.
# 여기서는 k3s까지만 한다. Argo CD·Secret·앱은 scripts/ec2/up.sh(SSM 셸)가 한다.
# 받는 파일은 모두 버전·SHA-256을 고정하고, 맞지 않으면 멈춘다. 바깥으로는 HTTPS(443)만 쓴다.
set -euo pipefail
exec > >(tee -a /var/log/ureka-bootstrap.log) 2>&1

marker=/var/lib/ureka/bootstrap-done
if [ -f "$marker" ]; then
  echo "already bootstrapped"
  exit 0
fi

K3S_VERSION='${k3s_version}'
K3S_SHA256='${k3s_sha256}'
K3S_INSTALL_SHA256='${k3s_install_sha256}'
ECR_PROVIDER_VERSION='${ecr_credential_provider_version}'
ECR_PROVIDER_SHA256='${ecr_credential_provider_sha256}'

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

fetch() { # url dest sha256
  curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 3 -o "$2" "$1"
  echo "$3  $2" | sha256sum -c -
}

# SELinux: AL2023 기본값(permissive)을 바꾸지 않는다. k3s-selinux 정책 패키지는 AL2023용 배포가 없어
# 설치하지 않으므로, enforcing이면 지원하지 않는 상태로 보고 멈춘다.
if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" = "Enforcing" ]; then
  echo "SELinux is Enforcing; k3s-selinux policy is not installed on AL2023. Stopping." >&2
  exit 1
fi

# 1) k3s 바이너리 + 같은 태그의 install.sh
k3s_tag=$(printf '%s' "$K3S_VERSION" | sed 's/+/%2B/')
fetch "https://github.com/k3s-io/k3s/releases/download/$k3s_tag/k3s" "$work/k3s" "$K3S_SHA256"
fetch "https://raw.githubusercontent.com/k3s-io/k3s/$k3s_tag/install.sh" "$work/install.sh" "$K3S_INSTALL_SHA256"
install -m 0755 "$work/k3s" /usr/local/bin/k3s

# 2) ECR 이미지 자격: kubelet이 노드 Role(IMDSv2)로 토큰을 받는다. Pod는 hop limit 1이라 못 받는다.
cred_dir=/var/lib/rancher/credentialprovider
install -d -m 0755 "$cred_dir/bin"
fetch "https://artifacts.k8s.io/binaries/cloud-provider-aws/$ECR_PROVIDER_VERSION/linux/amd64/ecr-credential-provider-linux-amd64" \
  "$work/ecr-credential-provider" "$ECR_PROVIDER_SHA256"
install -m 0755 "$work/ecr-credential-provider" "$cred_dir/bin/ecr-credential-provider"
cat > "$cred_dir/config.yaml" <<'EOF'
apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: ecr-credential-provider
    matchImages:
      - "*.dkr.ecr.*.amazonaws.com"
    defaultCacheDuration: "12h"
    apiVersion: credentialprovider.kubelet.k8s.io/v1
EOF

# 3) k3s 설정. Secret은 저장소 안에서 암호화한다. kubeconfig는 root만 읽는다.
install -d -m 0755 /etc/rancher/k3s
cat > /etc/rancher/k3s/config.yaml <<EOF
write-kubeconfig-mode: "0600"
secrets-encryption: true
image-credential-provider-bin-dir: "$cred_dir/bin"
image-credential-provider-config: "$cred_dir/config.yaml"
EOF

# 4) GitOps 부트스트랩(up.sh)이 읽을 레지스트리 주소. 계정 ID가 들어 있어 Git·로그에 쓰지 않는다.
install -d -m 0750 /etc/ureka
umask 027
cat > /etc/ureka/registry.env <<'EOF'
ECR_REGISTRY=${ecr_registry}
AWS_REGION=${aws_region}
EOF
umask 022

# 5) 설치. 바이너리는 위에서 검증한 것을 쓰고, SELinux 정책 패키지는 받지 않는다.
INSTALL_K3S_SKIP_DOWNLOAD=true \
INSTALL_K3S_VERSION="$K3S_VERSION" \
INSTALL_K3S_SKIP_SELINUX_RPM=true \
  sh "$work/install.sh"

# 6) 노드가 Ready가 될 때까지 기다린다(최대 5분).
for _ in $(seq 1 60); do
  if /usr/local/bin/k3s kubectl get node 2>/dev/null | grep -q ' Ready '; then
    install -d -m 0755 /var/lib/ureka
    touch "$marker"
    echo "k3s ready: $K3S_VERSION"
    exit 0
  fi
  sleep 5
done
echo "k3s did not become Ready in 5 minutes" >&2
exit 1
