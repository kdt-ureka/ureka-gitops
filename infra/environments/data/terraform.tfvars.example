# terraform.tfvars로 복사해서 쓴다. terraform.tfvars는 .gitignore 대상이다(커밋 금지).
allowed_account_ids = ["000000000000"]

# 메모리가 부족하면 db.t4g.small (apply_immediately=false라 다음 유지 관리 시간에 바뀐다)
# instance_class = "db.t4g.small"

# Set locally after EKS apply; clear and apply BEFORE EKS destroy.
eks_node_security_group_ids = []

# #63: EKS dev 비밀 복사 동안만 true(docs/eks-secrets.md). 복사 뒤 false로 되돌려 apply한다.
# eks_dev_secret_copy_enabled = false
