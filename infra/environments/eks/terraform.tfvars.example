# Copy to ignored terraform.tfvars. Never commit real IDs, role ARNs, or public IPs.
allowed_account_ids = ["123456789012"] # fictitious example
admin_role_arn = "arn:aws:iam::123456789012:role/REPLACE_WITH_SSO_ROLE_PATH"
admin_public_access_cidrs = ["192.0.2.1/32"] # documentation address; replace locally
# Verify region availability and compatibility before plan.
kubernetes_version = "1.37"
desired_nodes = 2
ami_release_version = "REPLACE_WITH_1.37_PATCH_DATE"
addon_versions = {
  vpc-cni = "REPLACE_WITH_COMPATIBLE_EKS_BUILD"
  coredns = "REPLACE_WITH_COMPATIBLE_EKS_BUILD"
  kube-proxy = "REPLACE_WITH_COMPATIBLE_EKS_BUILD"
  aws-ebs-csi-driver = "REPLACE_WITH_COMPATIBLE_EKS_BUILD"
}
# --- prod 공개 입구 (#64·#81, docs/eks-public.md) ---
# 1단계: public_enabled = true → apply → 컨트롤러·Ingress 동기화로 ALB 생성(시험자 IP만)
# 2단계: public_dns_enabled = true → apply (Route 53 별칭 레코드)
# 3단계: 공개 전 게이트 통과·파트장 승인 뒤 public_access_mode = "open" → apply
public_enabled     = false
public_dns_enabled = false
public_access_mode = "testers"
# 공개 주소(하위 도메인 하나). 기본값과 같으면 생략. environments/eks/prod/public-ingress.yaml의 host와 같아야 한다.
public_host = "ureka.magonjal.com"
# testers 단계에서 ALB에 들어올 수 있는 공인 IPv4 /32. 관리자 IP와, 관리자 목록에 없는 시험 IP(휴대폰 핫스팟 등)를 함께 넣는다.
alb_tester_cidrs = ["192.0.2.10/32", "198.51.100.20/32"] # documentation addresses; replace locally
# 관리자 경로(/admin, /api/admin)를 열어 줄 공인 IPv4 /32. 비우면 아무도 못 들어간다. 실제 값은 Git에 쓰지 않는다.
admin_path_allowed_cidrs = ["192.0.2.10/32"] # documentation address; replace locally
# 비회원 토큰 발급 IP별 제한: 5분(300초)에 20회. WAF 최소 10, 창은 60/120/300/600초만.
guest_token_rate_limit      = 20
guest_token_rate_window_sec = 300
